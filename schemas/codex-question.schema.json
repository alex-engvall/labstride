{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex question observation",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "turnId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "requestId": {
      "type": [
        "string",
        "integer"
      ]
    },
    "itemId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "questionIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "uniqueItems": true,
      "maxItems": 128
    },
    "status": {
      "enum": [
        "pending",
        "resolved"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "sessionId",
    "turnId",
    "requestId",
    "itemId",
    "questionIds",
    "status"
  ]
}
