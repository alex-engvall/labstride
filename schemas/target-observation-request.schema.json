{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Target observation request v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "observationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "targetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "environment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "configuration": {
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "observationId",
    "targetId",
    "environment",
    "configuration"
  ]
}
