{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workflow broker message v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "requestDigest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "claimId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    }
  },
  "required": [
    "schemaVersion",
    "requestDigest"
  ]
}
