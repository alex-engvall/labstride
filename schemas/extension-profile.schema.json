{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Run extension profile",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "configRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "pin": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Installed extension pin",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "kind": {
          "enum": [
            "provider",
            "connector",
            "action",
            "session-provider"
          ]
        },
        "integrity": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "artifactPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "configuration": {
          "type": "object"
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "uniqueItems": true,
          "maxItems": 128
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "uniqueItems": true,
          "maxItems": 128
        }
      },
      "required": [
        "id",
        "version",
        "kind",
        "integrity",
        "artifactPath",
        "configuration",
        "permissions",
        "capabilities"
      ]
    },
    "protocol": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Negotiated protocol",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "major": {
          "const": 1
        },
        "minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      },
      "required": [
        "major",
        "minor"
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "uniqueItems": true,
      "maxItems": 128
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "configRevision",
    "pin",
    "protocol",
    "capabilities"
  ]
}
