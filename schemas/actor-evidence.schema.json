{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "Verified request actor evidence",
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "installationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "providerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "externalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "subjectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "actorId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "repositoryId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "repository": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "configDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "observationDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "maxItems": 256,
      "uniqueItems": true,
      "minItems": 1
    }
  },
  "required": [
    "schemaVersion",
    "installationId",
    "providerId",
    "externalId",
    "subjectId",
    "actorId",
    "repositoryId",
    "repository",
    "configDigest",
    "generation",
    "observationDigest",
    "evidenceRefs"
  ]
}
