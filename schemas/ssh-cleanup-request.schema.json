{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trusted cleanup inspection request v4",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "4.0"
    },
    "requestId": {
      "$ref": "contract-common.schema.json#/$defs/id"
    },
    "installationId": {
      "$ref": "contract-common.schema.json#/$defs/id"
    },
    "targetId": {
      "$ref": "contract-common.schema.json#/$defs/id"
    },
    "targetRevision": {
      "type": "integer",
      "minimum": 1
    },
    "method": {
      "const": "inspect"
    },
    "workspaceId": {
      "$ref": "contract-common.schema.json#/$defs/id"
    },
    "creationOperationId": {
      "$ref": "contract-common.schema.json#/$defs/id"
    },
    "receiptDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy": {
      "$ref": "cleanup-policy.schema.json"
    }
  },
  "required": [
    "schemaVersion",
    "requestId",
    "installationId",
    "targetId",
    "targetRevision",
    "method",
    "workspaceId",
    "creationOperationId",
    "receiptDigest",
    "policy"
  ]
}
