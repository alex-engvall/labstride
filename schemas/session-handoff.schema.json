{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Session handoff",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "enrollmentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "expectedRunRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "expectedSessionRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "expectedLastTurnId": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1024
    },
    "expectedHumanActivityRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "runId",
    "enrollmentId",
    "expectedRunRevision",
    "expectedSessionRevision",
    "expectedLastTurnId",
    "expectedHumanActivityRevision"
  ]
}
