{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scheduling policy",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "activeRuns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024
    },
    "development": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024
    },
    "ciReview": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024
    }
  },
  "required": [
    "schemaVersion",
    "activeRuns",
    "development",
    "ciReview"
  ]
}
