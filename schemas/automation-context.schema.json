{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Automation context",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "sessionGuard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enrollmentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "expectedLastTurnId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        },
        "expectedHumanActivityRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "enrollmentId",
        "sessionId",
        "expectedLastTurnId",
        "expectedHumanActivityRevision"
      ]
    },
    "repair": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "failureFingerprint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "failureFingerprint"
      ]
    }
  },
  "required": [
    "schemaVersion"
  ]
}
