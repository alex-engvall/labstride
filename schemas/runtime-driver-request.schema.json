{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Runtime recipe driver request v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "method": {
      "enum": [
        "create",
        "inspect"
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "installationId": {
          "$ref": "contract-common.schema.json#/$defs/id"
        },
        "targetId": {
          "$ref": "contract-common.schema.json#/$defs/id"
        },
        "targetRevision": {
          "type": "integer",
          "minimum": 1
        },
        "runId": {
          "$ref": "contract-common.schema.json#/$defs/id"
        },
        "workspaceId": {
          "$ref": "contract-common.schema.json#/$defs/id"
        },
        "operationId": {
          "$ref": "contract-common.schema.json#/$defs/id"
        },
        "requestDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "workspaceOperationId": {
          "$ref": "contract-common.schema.json#/$defs/id"
        },
        "workspaceReceiptDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "recipe": {
          "$ref": "runtime-create-input.schema.json#/properties/recipe"
        },
        "namespace": {
          "type": "string",
          "pattern": "^rt-[a-f0-9]{40}$"
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^rt-[a-f0-9]{40}-[a-z][a-z0-9-]{0,15}$"
              },
              "type": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              }
            },
            "required": [
              "name",
              "type"
            ]
          }
        }
      },
      "required": [
        "installationId",
        "targetId",
        "targetRevision",
        "runId",
        "workspaceId",
        "operationId",
        "requestDigest",
        "workspaceOperationId",
        "workspaceReceiptDigest",
        "recipe",
        "namespace",
        "resources"
      ]
    },
    "bindingDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "receipt": {
          "$ref": "ssh-workspace-receipt.schema.json"
        }
      },
      "required": [
        "path",
        "receipt"
      ]
    },
    "configuration": {
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "method",
    "binding",
    "bindingDigest",
    "workspace",
    "configuration"
  ]
}
