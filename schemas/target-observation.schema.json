{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Independent target observation v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "observationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "targetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "environment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "resourceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "sourceRepositoryId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sourceSha": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[a-f0-9]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "health": {
      "enum": [
        "healthy",
        "unhealthy",
        "unknown"
      ]
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schemaVersion",
    "observationId",
    "targetId",
    "environment",
    "resourceId",
    "sourceRepositoryId",
    "sourceSha",
    "health",
    "observedAt"
  ]
}
