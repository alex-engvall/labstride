{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deployment order check v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "operationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "requestDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "resourceKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "predecessorOperationId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        {
          "type": "null"
        }
      ]
    },
    "predecessorEvidenceId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "targetRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "recoveryEpoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "comparison": {
      "anyOf": [
        {
          "$ref": "revision-comparison.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "decision": {
      "enum": [
        "allow",
        "supersede",
        "blocked"
      ]
    },
    "blocker": {
      "enum": [
        "none",
        "older_queued_revision",
        "revision_already_delivered",
        "revision_diverged",
        "comparison_unavailable",
        "legacy_order_unknown",
        "target_busy"
      ]
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schemaVersion",
    "operationId",
    "requestDigest",
    "sequence",
    "resourceKey",
    "predecessorOperationId",
    "predecessorEvidenceId",
    "targetRevision",
    "recoveryEpoch",
    "comparison",
    "decision",
    "blocker",
    "observedAt"
  ]
}
