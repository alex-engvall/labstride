{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "Operator policy change",
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "installationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740990
    },
    "change": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "publish"
            },
            "policy": {
              "$ref": "authorization-policy.schema.json"
            }
          },
          "required": [
            "kind",
            "policy"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "bind_run"
            },
            "runId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "policyRevision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "kind",
            "runId",
            "policyRevision"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "restrict"
            },
            "runId": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 1024
            },
            "paused": {
              "type": "boolean"
            },
            "actorIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "maxItems": 256,
              "uniqueItems": true
            },
            "repositoryIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "maxItems": 256,
              "uniqueItems": true
            },
            "targetIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "maxItems": 256,
              "uniqueItems": true
            },
            "actions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  }
                },
                "required": [
                  "id",
                  "version"
                ]
              },
              "maxItems": 256,
              "uniqueItems": true
            }
          },
          "required": [
            "kind",
            "runId",
            "paused",
            "actorIds",
            "repositoryIds",
            "targetIds",
            "actions"
          ]
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "installationId",
    "expectedRevision",
    "change"
  ]
}
