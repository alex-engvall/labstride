{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExecutionInboxInput",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "stream": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "event": {
      "$ref": "event.schema.json"
    },
    "checkpoint": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "expectedRevision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740990
            },
            "cursor": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "required": [
            "expectedRevision",
            "cursor"
          ]
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "stream",
    "event",
    "checkpoint"
  ]
}
