{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Runtime recipe driver reply v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "status": {
      "enum": [
        "ready",
        "outcome_unknown"
      ]
    },
    "bindingDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "resources": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "title": "Recipe resource evidence",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^rt-[a-f0-9]{40}-[a-z][a-z0-9-]{0,15}$"
          },
          "type": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "state": {
            "const": "ready"
          }
        },
        "required": [
          "name",
          "type",
          "locator",
          "state"
        ]
      }
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "contract-common.schema.json#/$defs/id"
      }
    }
  },
  "required": [
    "schemaVersion",
    "status",
    "bindingDigest",
    "resources",
    "evidenceRefs"
  ]
}
