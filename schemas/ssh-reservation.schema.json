{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Target registry reservation v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "installationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "minLength": 1,
      "maxLength": 256
    },
    "targetId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "minLength": 1,
      "maxLength": 256
    },
    "targetRevision": {
      "type": "integer",
      "minimum": 1
    },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "minLength": 1,
      "maxLength": 256
    },
    "workspaceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "minLength": 1,
      "maxLength": 256
    },
    "operationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "minLength": 1,
      "maxLength": 256
    },
    "requestDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "rootId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "minLength": 1,
      "maxLength": 256
    },
    "locator": {
      "type": "string",
      "pattern": "^ws-[a-f0-9]{40}$"
    },
    "state": {
      "const": "reserved"
    }
  },
  "required": [
    "schemaVersion",
    "installationId",
    "targetId",
    "targetRevision",
    "runId",
    "workspaceId",
    "operationId",
    "requestDigest",
    "rootId",
    "locator",
    "state"
  ]
}
