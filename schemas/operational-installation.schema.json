{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Operational installation v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "configuration": {
      "$ref": "config.schema.json"
    },
    "lock": {
      "$ref": "extension-lock.schema.json"
    },
    "policy": {
      "$ref": "authorization-policy.schema.json"
    },
    "historyQualifications": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "github-history-qualification.schema.json"
      }
    },
    "stateDirectory": {
      "type": "string",
      "pattern": "^/",
      "maxLength": 4096
    },
    "sourceRoot": {
      "type": "string",
      "pattern": "^/",
      "maxLength": 4096
    },
    "rootId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "targetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "credentials": {
      "type": "object",
      "propertyNames": {
        "pattern": "^secret:"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^/",
            "maxLength": 4096
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "github-app"
              },
              "appId": {
                "type": "string",
                "pattern": "^[0-9]+$"
              },
              "installationId": {
                "type": "integer",
                "minimum": 1
              },
              "keyFile": {
                "type": "string",
                "pattern": "^/"
              },
              "repositoryIds": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "permissions": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "enum": [
                    "read",
                    "write"
                  ]
                }
              }
            },
            "required": [
              "kind",
              "appId",
              "installationId",
              "keyFile",
              "repositoryIds",
              "permissions"
            ]
          }
        ]
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "major": {
              "const": 1
            },
            "minor": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "major",
            "minor"
          ]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "uniqueItems": true
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "uniqueItems": true
        }
      },
      "required": [
        "protocol",
        "capabilities",
        "permissions"
      ]
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bridgeSocket": {
          "type": "string",
          "pattern": "^/",
          "maxLength": 4096
        },
        "backendIdentity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "backendVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "checkedDelivery": {
          "const": true
        },
        "defaults": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "aiMode": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "reasoning": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "required": [
            "aiMode",
            "model",
            "reasoning"
          ]
        },
        "runtimeValues": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "aiMode": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "model": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "reasoning": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            }
          },
          "required": [
            "aiMode",
            "model",
            "reasoning"
          ]
        }
      },
      "required": [
        "bridgeSocket",
        "backendIdentity",
        "backendVersion",
        "checkedDelivery",
        "defaults",
        "runtimeValues"
      ]
    },
    "baseBranch": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_./-]+$",
      "maxLength": 256
    },
    "requiredWorkflows": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^\\.github/workflows/[A-Za-z0-9_.-]+\\.ya?ml$"
      }
    },
    "rootMappingFile": {
      "type": "string",
      "pattern": "^/",
      "maxLength": 4096
    }
  },
  "required": [
    "schemaVersion",
    "configuration",
    "lock",
    "policy",
    "historyQualifications",
    "stateDirectory",
    "sourceRoot",
    "rootId",
    "targetId",
    "revision",
    "credentials",
    "host",
    "agent",
    "baseBranch",
    "requiredWorkflows",
    "rootMappingFile"
  ]
}
