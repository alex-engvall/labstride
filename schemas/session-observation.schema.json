{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Labstride session observation v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "workspaceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "providerId": {
      "type": "string",
      "minLength": 1
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "ready",
        "busy",
        "waiting_human",
        "closed",
        "failed",
        "outcome_unknown"
      ]
    },
    "lastTurnId": {
      "type": [
        "string",
        "null"
      ]
    },
    "humanActivityRevision": {
      "type": "integer",
      "minimum": 0
    },
    "effectiveSettings": {
      "type": "object"
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    }
  },
  "required": [
    "schemaVersion",
    "workspaceId",
    "providerId",
    "sessionId",
    "state",
    "lastTurnId",
    "humanActivityRevision",
    "effectiveSettings",
    "evidenceRefs"
  ]
}
