{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Owned runtime receipt v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "installationId": {
      "$ref": "contract-common.schema.json#/$defs/id"
    },
    "targetId": {
      "$ref": "contract-common.schema.json#/$defs/id"
    },
    "targetRevision": {
      "type": "integer",
      "minimum": 1
    },
    "runId": {
      "$ref": "contract-common.schema.json#/$defs/id"
    },
    "workspaceId": {
      "$ref": "contract-common.schema.json#/$defs/id"
    },
    "operationId": {
      "$ref": "contract-common.schema.json#/$defs/id"
    },
    "requestDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "handle": {
      "$ref": "contract-common.schema.json#/$defs/id"
    },
    "workspaceOperationId": {
      "$ref": "contract-common.schema.json#/$defs/id"
    },
    "workspaceReceiptDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "recipe": {
      "$ref": "runtime-create-input.schema.json#/properties/recipe"
    },
    "namespace": {
      "type": "string",
      "pattern": "^rt-[a-f0-9]{40}$"
    },
    "bindingDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "title": "Recipe resource evidence",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^rt-[a-f0-9]{40}-[a-z][a-z0-9-]{0,15}$"
          },
          "type": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "state": {
            "const": "ready"
          }
        },
        "required": [
          "name",
          "type",
          "locator",
          "state"
        ]
      }
    },
    "cleanup": {
      "title": "Recipe disposal declaration",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actionId": {
          "$ref": "contract-common.schema.json#/$defs/id"
        },
        "actionVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "trigger": {
          "$ref": "contract-common.schema.json#/$defs/id"
        }
      },
      "required": [
        "actionId",
        "actionVersion",
        "trigger"
      ]
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "contract-common.schema.json#/$defs/id"
      }
    }
  },
  "required": [
    "schemaVersion",
    "installationId",
    "targetId",
    "targetRevision",
    "runId",
    "workspaceId",
    "operationId",
    "requestDigest",
    "handle",
    "workspaceOperationId",
    "workspaceReceiptDigest",
    "recipe",
    "namespace",
    "bindingDigest",
    "resources",
    "cleanup",
    "evidenceRefs"
  ]
}
