{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Run budget",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "maxRepairs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "unattendedMs": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 2592000000
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "runId",
    "expectedRevision",
    "maxRepairs",
    "unattendedMs"
  ]
}
