{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Labstride lifecycle audit",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "maxLength": 256
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "actorId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "maxItems": 64
    },
    "previousRevision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "recovery": {
      "type": "boolean"
    },
    "record": {
      "$ref": "lifecycle-record.schema.json"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "at",
    "actorId",
    "reason",
    "evidenceRefs",
    "previousRevision",
    "recovery",
    "record"
  ]
}
