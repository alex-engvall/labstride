{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trusted target helper response v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "minLength": 1,
      "maxLength": 256
    },
    "installationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "minLength": 1,
      "maxLength": 256
    },
    "targetId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "minLength": 1,
      "maxLength": 256
    },
    "targetRevision": {
      "type": "integer",
      "minimum": 1
    },
    "method": {
      "enum": [
        "probe",
        "reserve",
        "inspect"
      ]
    },
    "outcome": {
      "enum": [
        "ok",
        "error",
        "outcome_unknown"
      ]
    },
    "reservation": {
      "anyOf": [
        {
          "$ref": "ssh-reservation.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "capabilities": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "target.probe.v1",
          "target.reserve.v1",
          "target.inspect.v1"
        ]
      }
    },
    "error": {
      "anyOf": [
        {
          "$ref": "contract-common.schema.json#/$defs/error"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "requestId",
    "installationId",
    "targetId",
    "targetRevision",
    "method",
    "outcome",
    "reservation",
    "capabilities",
    "error"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "ok"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "reservation": {
            "type": "null"
          },
          "error": {
            "$ref": "contract-common.schema.json#/$defs/error"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "ok"
          },
          "method": {
            "enum": [
              "reserve",
              "inspect"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "reservation": {
            "$ref": "ssh-reservation.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "outcome_unknown"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "const": "outcome_unknown"
              }
            },
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "const": "probe"
          }
        }
      },
      "then": {
        "properties": {
          "reservation": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "error"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "not": {
              "type": "object",
              "properties": {
                "code": {
                  "const": "outcome_unknown"
                }
              },
              "required": [
                "code"
              ]
            }
          }
        }
      }
    }
  ]
}
