{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workflow action input v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "enrollment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "source": {
      "$ref": "operation.schema.json#/properties/source"
    }
  },
  "required": [
    "target",
    "enrollment",
    "source"
  ]
}
