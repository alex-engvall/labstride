{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trusted workspace helper policy v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "installationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "minLength": 1,
      "maxLength": 256
    },
    "targetId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "minLength": 1,
      "maxLength": 256
    },
    "targetRevision": {
      "type": "integer",
      "minimum": 1
    },
    "helperUid": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "codingUid": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "stateDir": {
      "type": "string",
      "pattern": "^/(?:[A-Za-z0-9_.-]+/)*[A-Za-z0-9_.-]+$",
      "maxLength": 4096
    },
    "roots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "minLength": 1,
            "maxLength": 256
          },
          "path": {
            "type": "string",
            "pattern": "^/(?:[A-Za-z0-9_.-]+/)*[A-Za-z0-9_.-]+$",
            "maxLength": 4096
          },
          "identity": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "device": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "inode": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "mountId": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "uid": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "device",
              "inode",
              "mountId",
              "uid"
            ]
          }
        },
        "required": [
          "id",
          "path",
          "identity"
        ]
      }
    },
    "codingGid": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "repositoryId": {
            "$ref": "contract-common.schema.json#/$defs/id"
          },
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "gitUrl": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          },
          "apiUrl": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          },
          "credentialFile": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^/(?:[A-Za-z0-9_.-]+/)*[A-Za-z0-9_.-]+$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "repositoryId",
          "repository",
          "gitUrl",
          "apiUrl",
          "credentialFile"
        ]
      }
    },
    "cleanup": {
      "title": "Qualified cleanup profile",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {
          "const": "linux-exclusive-writers.v1"
        }
      },
      "required": [
        "profile"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "installationId",
    "targetId",
    "targetRevision",
    "helperUid",
    "codingUid",
    "stateDir",
    "roots",
    "codingGid",
    "sources"
  ]
}
