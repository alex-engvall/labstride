{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workflow dispatch record v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "operationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "requestDigest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "enrollment": {
      "$ref": "workflow-enrollment.schema.json"
    },
    "submittedAt": {
      "type": "string",
      "format": "date-time"
    },
    "runId": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[1-9][0-9]*$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "operationId",
    "requestDigest",
    "enrollment",
    "submittedAt",
    "runId"
  ]
}
