{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Run control",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "command": {
      "enum": [
        "pause",
        "resume",
        "cancel"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "runId",
    "expectedRevision",
    "command"
  ]
}
