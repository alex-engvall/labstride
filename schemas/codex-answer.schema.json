{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex answer",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "turnId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "requestId": {
      "type": [
        "string",
        "integer"
      ]
    },
    "answers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1
      }
    }
  },
  "required": [
    "schemaVersion",
    "sessionId",
    "turnId",
    "requestId",
    "answers"
  ]
}
