{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deployment successor evidence v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "operationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "requestDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "successorOperationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "successorEvidenceId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "targetRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "mergeOperationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "mergeRecordDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "mergeSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "comparison": {
      "$ref": "revision-comparison.schema.json"
    },
    "probeRequest": {
      "$ref": "target-observation-request.schema.json"
    },
    "target": {
      "$ref": "target-observation.schema.json"
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "recoveryEpoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schemaVersion",
    "operationId",
    "requestDigest",
    "successorOperationId",
    "successorEvidenceId",
    "targetRevision",
    "mergeOperationId",
    "mergeRecordDigest",
    "mergeSha",
    "comparison",
    "probeRequest",
    "target",
    "observedAt",
    "recoveryEpoch"
  ]
}
