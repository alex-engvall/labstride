{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Operator diagnostic report v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "ok": {
      "type": "boolean"
    },
    "enabled": {
      "type": "boolean"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z_]{1,100}$"
          },
          "path": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "error",
              "warning",
              "info"
            ]
          },
          "status": {
            "enum": [
              "observed",
              "unavailable",
              "unsupported",
              "disabled",
              "declared"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "path",
          "severity",
          "status",
          "message"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "ok",
    "enabled",
    "diagnostics"
  ]
}
