{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GitHub merge enrollment V1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "nodeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "name",
        "nodeId",
        "id"
      ]
    },
    "targetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "baseBranch": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_./-]+$",
      "maxLength": 256
    },
    "method": {
      "enum": [
        "merge",
        "squash",
        "rebase"
      ]
    },
    "credentialRef": {
      "type": "string",
      "pattern": "^secret:",
      "maxLength": 1024
    },
    "protectionCredentialRef": {
      "type": "string",
      "pattern": "^secret:",
      "maxLength": 1024
    },
    "appId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "installationId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "actorId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "context": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "appId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "context",
          "appId"
        ]
      }
    },
    "workflows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "path": {
            "type": "string",
            "pattern": "^\\.github/workflows/[A-Za-z0-9_.-]+\\.ya?ml$"
          },
          "blobSha": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "appId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "path",
          "blobSha",
          "appId"
        ]
      }
    },
    "downstream": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "path": {
          "type": "string",
          "pattern": "^\\.github/workflows/[A-Za-z0-9_.-]+\\.ya?ml$"
        },
        "blobSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "appId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "path",
        "blobSha",
        "appId"
      ]
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mergeSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "pullRequest": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "runId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "mergeSha",
        "pullRequest",
        "runId"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "repository",
    "targetId",
    "baseBranch",
    "method",
    "credentialRef",
    "protectionCredentialRef",
    "appId",
    "installationId",
    "actorId",
    "checks",
    "workflows",
    "downstream",
    "qualification"
  ]
}
