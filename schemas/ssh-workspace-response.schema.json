{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trusted workspace helper response v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "minLength": 1,
      "maxLength": 256
    },
    "installationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "minLength": 1,
      "maxLength": 256
    },
    "targetId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "minLength": 1,
      "maxLength": 256
    },
    "targetRevision": {
      "type": "integer",
      "minimum": 1
    },
    "method": {
      "enum": [
        "probe",
        "create",
        "inspect"
      ]
    },
    "outcome": {
      "enum": [
        "ok",
        "error",
        "outcome_unknown"
      ]
    },
    "capabilities": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "workspace.probe.v1",
          "workspace.create.v1",
          "workspace.inspect.v1",
          "workspace.root-map.v1"
        ]
      }
    },
    "error": {
      "anyOf": [
        {
          "$ref": "contract-common.schema.json#/$defs/error"
        },
        {
          "type": "null"
        }
      ]
    },
    "workspace": {
      "anyOf": [
        {
          "$ref": "ssh-workspace-receipt.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "roots": {
      "$ref": "ssh-workspace-policy.schema.json#/properties/roots"
    }
  },
  "required": [
    "schemaVersion",
    "requestId",
    "installationId",
    "targetId",
    "targetRevision",
    "method",
    "outcome",
    "workspace",
    "capabilities",
    "error"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "ok"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "error": {
            "$ref": "contract-common.schema.json#/$defs/error"
          },
          "workspace": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "ok"
          },
          "method": {
            "enum": [
              "create",
              "inspect"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "workspace": {
            "$ref": "ssh-workspace-receipt.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "outcome_unknown"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "const": "outcome_unknown"
              }
            },
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "const": "probe"
          }
        }
      },
      "then": {
        "properties": {
          "workspace": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "error"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "not": {
              "type": "object",
              "properties": {
                "code": {
                  "const": "outcome_unknown"
                }
              },
              "required": [
                "code"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "roots"
        ],
        "type": "object",
        "properties": {
          "roots": {}
        }
      },
      "then": {
        "properties": {
          "method": {
            "const": "probe"
          },
          "outcome": {
            "const": "ok"
          },
          "capabilities": {
            "contains": {
              "const": "workspace.root-map.v1"
            },
            "type": "array"
          }
        }
      }
    }
  ]
}
