{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Revision comparison v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "repositoryId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "baseSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "headSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "relation": {
      "enum": [
        "identical",
        "ahead",
        "behind",
        "diverged"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "repositoryId",
    "baseSha",
    "headSha",
    "relation"
  ]
}
