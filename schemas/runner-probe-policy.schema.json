{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Operator-enrolled runner diagnostic policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "audience",
    "repository",
    "repositoryId",
    "ownerId",
    "workflowPath",
    "ref",
    "workflowSha",
    "runId",
    "runAttempt",
    "eventName"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "audience": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[!-~]+$"
    },
    "repository": {
      "type": "string",
      "maxLength": 201,
      "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9_.-]+$"
    },
    "repositoryId": {
      "$ref": "#/$defs/id"
    },
    "ownerId": {
      "$ref": "#/$defs/id"
    },
    "workflowPath": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^\\.github/workflows/[A-Za-z0-9_-]+\\.ya?ml$"
    },
    "ref": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^refs/heads/[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*$"
    },
    "workflowSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "runId": {
      "$ref": "#/$defs/id"
    },
    "runAttempt": {
      "$ref": "#/$defs/id"
    },
    "eventName": {
      "const": "push"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,15}$"
    }
  }
}
