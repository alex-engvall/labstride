{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cleanup tombstone v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "installationId": {
      "$ref": "contract-common.schema.json#/$defs/id"
    },
    "targetId": {
      "$ref": "contract-common.schema.json#/$defs/id"
    },
    "targetRevision": {
      "type": "integer",
      "minimum": 1
    },
    "workspaceId": {
      "$ref": "contract-common.schema.json#/$defs/id"
    },
    "creationOperationId": {
      "$ref": "contract-common.schema.json#/$defs/id"
    },
    "receiptDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "operationId": {
      "$ref": "contract-common.schema.json#/$defs/id"
    },
    "requestDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policyDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "directoryIdentity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "device": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "inode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mountId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "uid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "device",
        "inode",
        "mountId",
        "uid"
      ]
    },
    "deletedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schemaVersion",
    "installationId",
    "targetId",
    "targetRevision",
    "workspaceId",
    "creationOperationId",
    "receiptDigest",
    "operationId",
    "requestDigest",
    "policyDigest",
    "directoryIdentity",
    "deletedAt"
  ]
}
