{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public installation v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "configuration": {
      "$ref": "config.schema.json"
    },
    "lock": {
      "$ref": "extension-lock.schema.json"
    },
    "policy": {
      "$ref": "authorization-policy.schema.json"
    },
    "historyQualifications": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "github-history-qualification.schema.json"
      }
    },
    "stateDirectory": {
      "type": "string",
      "pattern": "^/",
      "maxLength": 4096
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "credentials": {
      "type": "object",
      "propertyNames": {
        "pattern": "^secret:"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^/",
            "maxLength": 4096
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "github-app"
              },
              "appId": {
                "type": "string",
                "pattern": "^[0-9]+$"
              },
              "installationId": {
                "type": "integer",
                "minimum": 1
              },
              "keyFile": {
                "type": "string",
                "pattern": "^/"
              },
              "repositoryIds": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "permissions": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "enum": [
                    "read",
                    "write"
                  ]
                }
              }
            },
            "required": [
              "kind",
              "appId",
              "installationId",
              "keyFile",
              "repositoryIds",
              "permissions"
            ]
          }
        ]
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "major": {
              "const": 1
            },
            "minor": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "major",
            "minor"
          ]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "uniqueItems": true
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "uniqueItems": true
        }
      },
      "required": [
        "protocol",
        "capabilities",
        "permissions"
      ]
    },
    "brokerListener": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "required": [
        "port"
      ]
    },
    "mergeEnabled": {
      "type": "boolean",
      "default": false
    },
    "schemaVersion": {
      "const": "2.0"
    },
    "profile": {
      "const": "public"
    },
    "brokerProbe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy": {
          "$ref": "runner-probe-policy.schema.json"
        },
        "maxAgeSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 604800,
          "default": 86400
        }
      },
      "required": [
        "policy"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "profile",
    "configuration",
    "lock",
    "policy",
    "historyQualifications",
    "stateDirectory",
    "revision",
    "credentials",
    "host"
  ]
}
