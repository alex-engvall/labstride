{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deployment order v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "operationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "requestDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "resourceKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "sourceRepositoryId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "sourceSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "expectedPredecessor": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "operationId",
    "requestDigest",
    "sequence",
    "resourceKey",
    "sourceRepositoryId",
    "sourceSha",
    "expectedPredecessor"
  ]
}
