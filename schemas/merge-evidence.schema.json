{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GitHub merge gate evidence V1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "head": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "base": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "testMerge": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "protectionDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "context": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "appId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "sha": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          }
        },
        "required": [
          "context",
          "appId",
          "id",
          "sha"
        ]
      }
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "attempt": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "workflowId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "blobSha": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          }
        },
        "required": [
          "id",
          "attempt",
          "workflowId",
          "blobSha"
        ]
      }
    },
    "qualification": {
      "$ref": "merge-qualification.schema.json"
    }
  },
  "required": [
    "schemaVersion",
    "head",
    "base",
    "testMerge",
    "protectionDigest",
    "checks",
    "runs",
    "qualification"
  ]
}
