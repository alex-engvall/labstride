{
  "schemaVersion": "3.0",
  "workspacePolicy": {
    "schemaVersion": "2.0",
    "installationId": "installation-example",
    "targetId": "target-example",
    "targetRevision": 1,
    "helperUid": 1234,
    "codingUid": 2345,
    "stateDir": "/var/lib/labstride-example/helper",
    "roots": [
      {
        "id": "source",
        "path": "/srv/labstride-example/workspaces",
        "identity": {
          "device": 1,
          "inode": 2,
          "mountId": 3,
          "uid": 1234
        }
      }
    ],
    "codingGid": 1002,
    "sources": [
      {
        "repositoryId": "repo-example",
        "repository": "example/source",
        "gitUrl": "https://github.com/example/source.git",
        "apiUrl": "https://api.github.com/repos/example/source",
        "credentialFile": null
      }
    ]
  },
  "runtimePolicy": {
    "schemaVersion": "1.0",
    "installationId": "installation-example",
    "targetId": "target-example",
    "targetRevision": 1,
    "helperUid": 1234,
    "stateDir": "/var/lib/labstride/runtimes",
    "recipes": [
      {
        "id": "example.sqlite",
        "version": "1.0.0",
        "driver": {
          "path": "/opt/labstride/recipes/node-resources.mjs",
          "integrity": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        },
        "configuration": {
          "kind": "sqlite",
          "root": "/srv/labstride/runtimes"
        },
        "resources": [
          {
            "key": "db",
            "type": "database"
          }
        ],
        "cleanup": {
          "actionId": "example.runtime-stop",
          "actionVersion": "1.0.0",
          "trigger": "workspace.completed"
        },
        "timeoutMs": 10000
      }
    ]
  }
}
