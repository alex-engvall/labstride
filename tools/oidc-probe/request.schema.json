{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labstride.dev/discovery/oidc-probe-request/1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "probeId"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "probeId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
    "case": {"enum": ["positive", "wrong-repository", "wrong-workflow", "wrong-run", "wrong-attempt"]}
  }
}
